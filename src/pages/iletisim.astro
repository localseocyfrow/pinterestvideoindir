---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const path = '/iletisim/';
const title = `İletişim – ${SITE.name}`;
const description =
  'Pinterest Video İndir ile iletişime geçin. Soru, öneri, geri bildirim veya iş birliği talepleriniz için bize ulaşın.';
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  schemas={[
    breadcrumbSchema([
      { name: 'Ana Sayfa', href: '/' },
      { name: 'İletişim', href: path },
    ]),
  ]}
>
  <article class="section">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Ana Sayfa</a><span>/</span>İletişim
      </nav>
      <div class="prose">
        <span class="eyebrow">İletişim</span>
        <h1>Bize Ulaşın</h1>
        <p class="lead">
          Soru, öneri ve geri bildirimlerinizi memnuniyetle karşılıyoruz.
        </p>

        <p>
          Formu doldurun; mesaj {SITE.email} adresine iletilir. Dilerseniz
          doğrudan da yazabilirsiniz. Yanıt genellikle 1–2 iş günü sürer.
        </p>

        <form id="contact-form" class="contact-form" novalidate>
          <label>
            Ad
            <input class="tool-input" name="name" type="text" autocomplete="name" required maxlength="80" />
          </label>
          <label>
            E-posta
            <input class="tool-input" name="email" type="email" autocomplete="email" required maxlength="120" />
          </label>
          <label>
            Mesaj
            <textarea class="tool-input" name="message" rows="6" required minlength="10" maxlength="4000"></textarea>
          </label>
          <label class="visually-hidden" aria-hidden="true">
            Şirket
            <input name="company" type="text" tabindex="-1" autocomplete="off" />
          </label>
          <button class="btn btn-primary" type="submit">Gönder</button>
          <p id="contact-status" role="status"></p>
        </form>

        <p>
          Telif kaldırma için <a href="/dmca/">DMCA</a> sayfasını kullanın.
          E-posta: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>

        <h2>Sık gelen konular</h2>
        <ul>
          <li><strong>Teknik sorun:</strong> İndirme sırasında karşılaştığınız hataları bize iletin.</li>
          <li><strong>Öneri:</strong> Yeni özellik veya iyileştirme fikirleriniz.</li>
          <li><strong>Telif / kaldırma talebi:</strong> Hak sahibiyseniz ilgili içeriğin kaldırılması için bize yazın.</li>
        </ul>

        <p style="margin-top:20px">
          Hemen başlamak isterseniz <a href="/">Pinterest video indirme aracımıza</a> göz atın.
        </p>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#contact-status');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !status) return;
    const data = new FormData(form);
    status.textContent = 'Gönderiliyor…';
    try {
      const response = await fetch('/api/contact/', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          name: data.get('name'),
          email: data.get('email'),
          message: data.get('message'),
          company: data.get('company'),
        }),
      });
      const payload = await response.json();
      status.textContent = payload.message || (response.ok ? 'Mesajınız alındı.' : 'Mesaj gönderilemedi.');
      if (response.ok && payload.success) form.reset();
    } catch {
      status.textContent = 'Mesaj gönderilemedi. E-posta adresini kullanın.';
    }
  });
</script>

<style>
  .contact-form {
    display: grid;
    gap: 14px;
    max-width: 560px;
    margin: 22px 0 28px;
  }
  .contact-form label {
    display: grid;
    gap: 6px;
    font-weight: 700;
  }
  .contact-form textarea { resize: vertical; min-height: 140px; }
</style>
